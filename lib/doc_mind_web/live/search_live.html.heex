<div style="padding-top: 5rem; padding-bottom: 4rem; max-width: 42rem; margin-left: auto; margin-right: auto; padding-left: 2rem; padding-right: 2rem;">
  <DocMindWeb.SearchHeader.search_header stats={@stats} />

  <div class="border border-base-300 rounded-2xl overflow-hidden shadow-sm">
    <DocMindWeb.SearchTabs.search_tabs tab={@tab} />

    <div class="bg-base-100 px-6 py-6">
      <DocMindWeb.QueryForm.query_form tab={@tab} query={@query} rerank={@rerank} />

      <DocMindWeb.IndexPanel.index_panel
        :if={@tab == :index}
        index_message={@index_message}
        index_message_type={@index_message_type}
        indexing={@indexing}
        index_log={@index_log}
        uploads={@uploads}
      />

      <DocMindWeb.SourcesPanel.sources_panel
        :if={@tab == :sources}
        source_list={@source_list}
        collections={@collections}
      />
    </div>
  </div>

  <DocMindWeb.SearchResults.search_results :if={@tab == :search} results={@results} />

  <DocMindWeb.AskAnswer.ask_answer :if={@tab == :ask} answer={@answer} />
</div>
